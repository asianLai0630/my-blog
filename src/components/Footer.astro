---
interface Props { variant: string }
const variants = import.meta.glob('./markup/footer-*.html', {
  eager: true, query: '?raw', import: 'default',
});
const markup = variants[`./markup/${Astro.props.variant}.html`];
if (typeof markup !== 'string') throw new Error('Unknown footer variant');
---
<Fragment set:html={markup} />
